  optionIndex = 0
  ensureTicks(true)
  render()
end

local function renderTabs()
  local function tab(id, label, glyphName)
    return ui.button({
      key = "tab_" .. id,
      text = label,
      glyph = glyphName,
      variant = activeTab == id and "primary" or "ghost",
      controlSize = "sm",
      onClick = function() switchTab(id) end,
    })
  end
  -- Icono igual al de la lista: el glifo y el color del runner (Steam azul,
  -- Heroic violeta, Faugus rosa), como el que aparece en la cabecera de cada
  -- caja de juego.
  local function shortcut(s)
    -- ui.box no dibuja sus hijos; ui.row sí (como la cabecera de cada caja).
    return ui.row({
      width = 26,
      height = 26,
      radius = 6,
      fill = "surface_variant",
      border = "outline/0.4",
      borderWidth = 1,
      align = "center",
      justify = "center",
