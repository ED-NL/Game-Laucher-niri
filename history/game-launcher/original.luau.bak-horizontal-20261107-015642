-- .desktop propios que añaden una segunda forma de abrir un juego (una
-- variante con gamescope) sin duplicarlo en la lista: plegada en su título
-- base por foldVariants, y ofrecida al pulsar la fila. También entran aquí
-- los juegos que solo existen como .desktop (League of Legends vía
-- darling-lol). La lista se limita a estos id, para no arrastrar el resto de
-- la categoría Game (launchers y tiendas, que ya se escanean como runners
-- propios).
local DESKTOP_GAMES = {
  "stellar-blade-gamescope",
  "mortal-kombat-1-gamescope",
  "gears-e-day-gamescope",
  "league-of-legends",
  "mortal-shell-2-gamescope",
  "ctr-nitro-fueled",
  "infamous-second-son",
}

local function parseDesktopEntry(id)
  local path = homeDir() .. "/.local/share/applications/" .. id .. ".desktop"
  if not noctalia.fileExists(path) then return nil end
  local text = noctalia.readFile(path)
  if not text or #text == 0 then return nil end

  -- Only the [Desktop Entry] group; localized keys such as Name[es] and
  -- groups such as Desktop Action are deliberately ignored.
  local inGroup, name, icon, typ, cats, hidden = false, nil, nil, nil, nil, false
  for line in text:gmatch("[^\n]+") do
    if line:sub(1, 1) == "[" then
      inGroup = (line:match("^%[Desktop Entry%]") ~= nil)
    elseif inGroup then
      local k, v = line:match("^([%w%-]+)=(.*)$")
      if k then
        if k == "Name" and not name then
          name = v
        elseif k == "Icon" then
          icon = v
        elseif k == "Type" then
          typ = v
        elseif k == "Categories" then
          cats = v
        elseif k == "Hidden" or k == "NoDisplay" then
          if v:lower() == "true" then hidden = true end
        end
      end
    end
  end

  if hidden or typ ~= "Application" then return nil end
  if not name or name == "" then return nil end
  if cats and not cats:lower():find("game", 1, true) then return nil end

  -- A hand-picked cover (2:3) wins over the .desktop icon: put one in
  -- <data>/noctalia/game-covers/<id>.jpg to replace a generic icon.
  local custom = homeDir() .. "/.local/share/noctalia/game-covers/" .. id .. ".jpg"
  local cover = (icon and noctalia.fileExists(icon)) and icon or ""
  if noctalia.fileExists(custom) then cover = custom end

  return {
    id = id,
    name = name,
    runner = "desktop",
    -- Absolute paths only: the bare icon names used by system packages are
    -- resolved by the desktop and would fail the check in renderGameRow.
    cover = cover,
    cover_url = "",
    run_command = "desktop://" .. path,
    slug = "",
  }
end

local function appendDesktopGames()
  for _, id in ipairs(DESKTOP_GAMES) do
    local entry = parseDesktopEntry(id)
    if entry then
      local duplicate = false
      for _, g in ipairs(games) do
        if g.id == entry.id or g.name == entry.name then
          duplicate = true
          break
        end
      end
      if not duplicate then
        -- Inserta en orden alfabético (igual que el escáner) para que las
        -- variantes de un mismo juego ("X" y "X (gamescope)") queden juntas.
        local key = entry.name:lower()
        local pos = #games + 1
        for i, g in ipairs(games) do
          if tostring(g.name or ""):lower() > key then
            pos = i
            break
          end
        end
        table.insert(games, pos, entry)
      end
    end
  end
end

