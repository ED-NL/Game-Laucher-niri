local function launcherShortcutAvailable(s)
  if s.flatpak and noctalia.commandExists("flatpak") then return true end
  if s.desktop and noctalia.fileExists(s.desktop) then return true end
  return s.bin ~= nil and noctalia.commandExists(s.bin) == true
end

local function launchShortcut(s)
  -- El acceso directo cierra el panel igual que hace "Jugar" (launchGame
  -- llama a onClose()): así la ventana del launcher queda a la vista en
  -- lugar del panel.
  -- Flatpak primero: flatpak run es inequívoco y no depende del orden de
  -- preferencia de los manejadores de xdg.
  if s.flatpak and noctalia.commandExists("flatpak") then
    -- setsid -f desprende el proceso en otra sesión: sin eso, al cerrar el
    -- panel su grupo de procesos mataba Steam/Heroic a los ~5 segundos.
    noctalia.runAsync("setsid -f flatpak run " .. shellQuote(s.flatpak))
    onClose()
    return
  end
  if s.desktop and noctalia.fileExists(s.desktop) then
    noctalia.runAsync("gio launch " .. shellQuote(s.desktop), function(res)
      if res and res.exitCode and res.exitCode ~= 0 then
        noctalia.log("shortcut " .. s.id .. " falló con exit " .. tostring(res.exitCode))
      end
    end)
    onClose()
  elseif s.bin and noctalia.commandExists(s.bin) then
    noctalia.runAsync("setsid -f " .. shellQuote(s.bin))
    onClose()
  else
    noctalia.notify("Game Launcher", "No se encontró " .. s.label)
  end
end

-- Nombre legible del runner: "external" es Faugus, el lanzador con el que se
-- abre un .exe de un disco.
local function runnerDisplayName(runner)
  if runner == "external" then return "Faugus" end
  return tostring(runner or "")
end

