render = function()
  local ok, err = pcall(function()
    local body, bodyWidget
    if activeTab == TAB_BROWSE then
      body = renderBrowseHeader()
      bodyWidget = ui.column({ flexGrow = 1, gap = 6 }, {
        body,
        renderBrowseBody(),
      })
    elseif activeTab == TAB_ADD then
      if addExePath then
        bodyWidget = renderAddNameForm()
      else
        body = renderBrowseHeader()
        bodyWidget = ui.column({ flexGrow = 1, gap = 6 }, {
          body,
          ui.row({ align = "center", gap = 8, paddingH = 2 }, {
            ui.glyph({ name = "plus", size = 14, color = "primary" }),
            ui.label({
              text = "Elige el .exe del juego y luego escribe su nombre: con ese nombre se busca la portada.",
              fontSize = 12,
              color = "on_surface_variant",
              flexGrow = 1,
              maxLines = 2,
            }),
          }),
          renderBrowseBody(),
        })
      end
    else
      local showJukebox = viewMode == "jukebox" and not loading and errorMsg == "" and #filtered > 0
      if showJukebox then
        bodyWidget = renderJukebox()
      else
        body = renderBody(renderGameList())
        if loading or errorMsg ~= "" or #filtered == 0 then
          bodyWidget = ui.column({ flexGrow = 1, gap = 6 }, body)
        else
          -- The wheel scrolls this container natively. onScroll maps the
          -- resulting offset back onto the selection, so the highlighted row
          -- follows the view and Return launches whatever is in front.
          bodyWidget = ui.scroll({
            key = "gl-games-scroll",
            flexGrow = 1,
            gap = 6,
            padding = 10,
            fill = "surface_variant/0.28",
            radius = 18,
            border = "outline/0.45",
            borderWidth = 1,
            revealKey = revealKey,
            onScroll = function(offset, _maxOffset)
              local idx = math.floor((tonumber(offset) or 0) / ROW_H)
              if idx < 0 then idx = 0 end
              if idx > #filtered - 1 then idx = #filtered - 1 end
              if idx ~= selectedIndex then
                selectedIndex = idx
                -- La rueda cambia de juego: las opciones abiertas eran de otro.
                if expandedId then
                  expandedId = nil
                  optionIndex = 0
                end
                render()
              end
            end,
          }, body)
        end
      end
    end
    -- Las opciones de lanzamiento se pintan dentro de la fila del juego que
    -- las tiene expandidas (al lado del juego), no en una zona fija de abajo:
    -- meterlas en el contenedor con scroll cambiaría la altura de paso que
    -- usa la rueda para pasar de desplazamiento a selección.
    -- En el paso del nombre no hay nada que buscar: la barra desaparece para
    -- que el campo de texto sea el único foco.
    local showSearch = not (activeTab == TAB_ADD and addExePath)
    local head = { renderHeader(), renderTabs() }
    if showSearch then table.insert(head, renderSearchBar()) end
    local rootChildren = {
      ui.column({ gap = 8 }, head),
      bodyWidget,
    }
    panel.render(ui.column({ flexGrow = 1, gap = 8, padding = 12 }, rootChildren))
    -- Se pide una sola vez: si quedara fijo, cada repintado de la animación
    -- volvería a arrastrar la vista a la fila seleccionada.
    revealKey = nil
  end)
  if not ok then
    noctalia.log("render error: " .. tostring(err))
  end
end

-- ---------------------------------------------------------------------------
-- Animación de la estantería: el host entrega un tick por fotograma mientras
-- el panel está abierto. Solo se pide mientras hay algo moviéndose, para no
-- repintar la lista a 60 fps sin motivo.
-- ---------------------------------------------------------------------------
ensureTicks = function(on)
  if ticking == on then return end
  ticking = on
  pcall(function() panel.setNeedsFrameTick(on) end)
end

-- True si el juego está en la lista visible (una variante plegada no lo
-- está, y su caja no se puede abrir porque no tiene fila propia).
local function visibleGame(id)
  for _, g in ipairs(filtered) do
    if g.id == id then return g end
  end
  return nil
end

-- Arranca la apertura de la caja. El juego se lanza de verdad cuando la
-- animación termina; si el panel se cierra antes (Escape), onClose la
-- cancela y no se lanza nada. caseId es la fila que se abre (la base); para
-- un botón de opciones se pasa la base, así la caja que gira es la del juego
-- que se va a ejecutar aunque sea "X (gamescope)".
beginLaunch = function(g, caseId)
  if launchingId or not g then return end
  local cid = caseId or g.id
  local caseGame = visibleGame(cid)
  if not caseGame then caseGame = visibleGame(g.id) or g; cid = caseGame.id end
  launchingId = g.id
  launchingCaseId = cid
  launchElapsed = 0
  launchLid = 0
  launchRenderAcc = 0
  hoveredId = nil
  expandedId = nil
  optionIndex = 0
  prepareDisc(caseGame)
  ensureTicks(true)
  render()
end

function onFrameTick(deltaMs)
  local dt = tonumber(deltaMs) or 16

  if launchingId then
    -- La caja abierta manda: ni hover ni crecimiento mientras se lanza.
    launchElapsed = launchElapsed + dt
    -- Tapa: InOutCubic de 0 a 1 en LID_MS, como el NumberAnimation del repo.
    local t = launchElapsed / LID_MS
    if t > 1 then t = 1 end
    if t < 0.5 then
      launchLid = 4 * t * t * t
    else
      launchLid = 1 - ((-2 * t + 2) ^ 3) / 2
    end
    anim[launchingCaseId] = 1
    if launchElapsed >= LAUNCH_MS then
      local target = launchingId
      launchingId = nil
      launchingCaseId = nil
      launchElapsed = 0
      launchLid = 0
      launchRenderAcc = 0
      ensureTicks(false)
      launchGame(target)
      return
    end
    -- Repintar a ~30 fps: el host entrega un tick por fotograma y repintar
    -- toda la lista a 100 fps triplica el coste sin que se note.
    launchRenderAcc = launchRenderAcc + dt
    if launchRenderAcc >= 32 then
      launchRenderAcc = 0
      render()
    end
    return
  end

  -- Suavizado exponencial: mismo resultado a 30 o a 144 fps.
  local k = 1 - (0.001 ^ (dt / 220))
  local focus = focusedGame()
  local moving = false
  for _, g in ipairs(filtered) do
    local target = (focus and focus.id == g.id) and 1 or 0
    local v = anim[g.id] or 0
    if math.abs(target - v) > 0.004 then
      v = v + (target - v) * k
      if math.abs(target - v) < 0.005 then v = target end
      anim[g.id] = v
      moving = true
    else
      anim[g.id] = target
    end
  end
  local dimTarget = hoveredId and 1 or 0
  if math.abs(dimTarget - dim) > 0.01 then
    dim = dim + (dimTarget - dim) * k
    moving = true
  else
    dim = dimTarget
  end
  if moving then render() end
end

-- Hover de una caja: crece ella y las demás se atenúan. No mueve la
-- selección: el cursor suele quedar sobre el panel y el hover se reevalúa
-- al repintar (la estantería animada cambia la geometría), así que pisaría
-- la navegación con teclado o mando. La rueda y el teclado mandan.
function onCardHover(state, key)
  if launchingId then return end
  if state == "true" then
    if hoveredId == key then return end
    hoveredId = key
  else
    if hoveredId ~= key then return end
    hoveredId = nil
  end
  ensureTicks(true)
  render()
end

local scanGames

local function buildBinary()
  if building then return end
  building = true
  loading = true
  errorMsg = ""
  render()
  local cmd = buildCommand()
  local ok = noctalia.runAsync(cmd, function(res)
    building = false
    if res.exitCode == 0 then
      loading = false
      markBuilt()
      scanGames()
    else
      loading = false
      errorMsg = "Failed to build gamelauncher. Install gcc. (exit " .. (res.exitCode or "?") .. ")"
      noctalia.log("build failed (cmd: " .. cmd .. "): " .. (res.stderr or "no stderr"))
      render()
    end
  end)
  if not ok then
    building = false
    loading = false
    errorMsg = "Failed to start build process"
    render()
  end
end

function scanGames()
  if loading or building then return end
  if not binaryReady() then
    buildBinary()
    return
  end
  loading = true
  errorMsg = ""
  scanCounter = scanCounter + 1
  searchText = ""
  render()
  local flags = ""
  if isRunnerEnabled("steam") then flags = flags .. " --steam" end
  if isRunnerEnabled("lutris") then flags = flags .. " --lutris" end
  if isRunnerEnabled("heroic") then flags = flags .. " --heroic" end
  local ok = noctalia.runAsync(binary .. flags .. " --force", function(res)
    local ok3, err3 = pcall(function()
      loading = false
      if res.exitCode == 0 and res.stdout and #res.stdout > 0 then
        local parsed, err2 = noctalia.json.decode(res.stdout)
        if parsed then
          games = parsed
          coverExists = {}
          -- The scanner below only walks Steam, Lutris and Heroic, so
          -- .desktop-only games have to be added by hand.
          pcall(appendDesktopGames)
          pcall(appendExternalGames)
          pcall(noctalia.state.set, "games", games)
          fetchMissingCovers()
        else
          errorMsg = "Failed to parse game list: " .. (err2 or "unknown error")
          noctalia.log("parse error on stdout: " .. res.stdout:sub(1, 200))
          games = {}
        end
      else
        errorMsg = "Game scan failed (exit " .. (res.exitCode or "?") .. ")"
        if res.stderr and #res.stderr > 0 then
          errorMsg = errorMsg .. ": " .. res.stderr:sub(1, 200)
        end
        games = {}
      end
      selectedIndex = 0
      filterGames(searchText)
    end)
    if not ok3 then
      loading = false
      errorMsg = "Scan error: " .. tostring(err3)
      games = {}
      filtered = games
      selectedIndex = 0
      noctalia.log("scan callback error: " .. tostring(err3))
    end
    render()
  end)
  if not ok then
    loading = false
    errorMsg = "Failed to start game scan"
    render()
  end
end


function onOpen(context)
  noctalia.state.set("o_open", true)
  selectedIndex = 0
  hoveredId = nil
  dim = 0
  launchingId = nil
  launchingCaseId = nil
  launchElapsed = 0
  launchLid = 0
  launchRenderAcc = 0
  filterGames(searchText)
  render()
  ensureTicks(true)
  scanGames()
end

function onClose()
  -- Cerrar el panel cancela un lanzamiento en curso: el juego solo arranca
  -- al terminar la animación de apertura.
  launchingId = nil
  launchingCaseId = nil
  launchElapsed = 0
  launchLid = 0
  launchRenderAcc = 0
  ensureTicks(false)
  panel.close()
end

function onRescan()
  scanGames()
end

-- CLI hook, so the panel can be exercised without a pointer:
--   noctalia msg plugin alexander/game-launcher:original all status
--   noctalia msg plugin alexander/game-launcher:original all tab browse
--   noctalia msg plugin alexander/game-launcher:original all dir /ruta
--   noctalia msg plugin alexander/game-launcher:original all disks
--   noctalia msg plugin alexander/game-launcher:original all back
--   noctalia msg plugin alexander/game-launcher:original all launch "halo"
--   noctalia msg plugin alexander/game-launcher:original all add /ruta/juego.exe
--   noctalia msg plugin alexander/game-launcher:original all forget juego
-- Añade el juego recién registrado a la vitrina y abre su caja. Es global a
-- propósito: también lo usa el despachador de IPC, donde no conviene
-- depender de locales compartidos del chunk.
function launchAddedGame(g)
  if not g then return end
  switchTab(TAB_GAMES)
  filterGames("")
  beginLaunch(g)
end

-- Botones del paso de nombre de "Añadir juego".
function confirmAddGame()
  if not addExePath then return end
  local g = addGameFromExe(addExePath, addName)
  addExePath = nil
  addName = ""
  launchAddedGame(g)
end

function cancelAddGame()
  addExePath = nil
  addName = ""
  render()
end

function onIpc(event, payload)
  local arg = (type(payload) == "string") and payload or ""
  if event == "shortcuts" then
    -- Diagnóstico: qué accesos directos ve el panel y si su entrada existe.
    for _, s in ipairs(launcherShortcuts) do
      noctalia.log(string.format(
        "game-launcher shortcut %s: disponible=%s desktop=%s icon=%s bin=%s",
        s.id, tostring(launcherShortcutAvailable(s)),
        tostring(s.desktop and noctalia.fileExists(s.desktop)),
        tostring(s.icon and noctalia.fileExists(s.icon)),
        tostring(s.bin)))
    end
  elseif event == "shortcut" then
    -- Diagnóstico: abre por CLI el launcher indicado (steam, heroic…).
    for _, s in ipairs(launcherShortcuts) do
      if s.id == arg then
        noctalia.log("game-launcher shortcut: abriendo " .. s.label)
        launchShortcut(s)
        return
      end
    end
    noctalia.log("game-launcher shortcut: id desconocido [" .. arg .. "]")
  elseif event == "tab" then
    if arg == "browse" then
      switchTab(TAB_BROWSE)
    elseif arg == "add" then
      switchTab(TAB_ADD)
    else
      switchTab(TAB_GAMES)
    end
  elseif event == "view" then
    local v = tostring(arg):match("^%s*(.-)%s*$")
    if v == "shelf" or v == "jukebox" then
      viewMode = v
      hoveredId = nil
      expandedId = nil
      optionIndex = 0
      ensureTicks(true)
      render()
    else
      toggleViewMode()
    end
  elseif event == "add" then
    -- CLI: añade el .exe indicado y lo abre con Faugus. Admite
    -- "/ruta/juego.exe|Nombre del juego" para fijar el nombre de la portada.
    local exe, name = arg:match("^(.-)|(.*)$")
    launchAddedGame(addGameFromExe(exe or arg, name))
  elseif event == "pick" then
    -- CLI: simula elegir un .exe en "Añadir juego" (abre el paso del nombre).
    local exe, name = arg:match("^(.-)|(.*)$")
    arg = exe or arg
    if #arg > 0 then
      activeTab = TAB_ADD
      addExePath = arg
      addName = (name and #name > 0) and name or nameForAdd(arg)
      render()
    end
  elseif event == "forget" then
    -- CLI: quita de la vitrina y del JSON un juego añadido (id o nombre).
    local needle = arg:lower()
    for i = #games, 1, -1 do
      local g = games[i]
      if g.runner == "external"
        and (tostring(g.id):lower() == needle or tostring(g.name):lower() == needle) then
        table.remove(games, i)
      end
    end
    for i = #externalExtra, 1, -1 do
      local g = externalExtra[i]
      if tostring(g.id):lower() == needle or tostring(g.name):lower() == needle then
        table.remove(externalExtra, i)
      end
    end
    saveExternalExtra()
    filterGames(searchText)
    render()
  elseif event == "dir" then
    loadBrowseDir((#arg > 0) and arg or homeDir())
  elseif event == "disks" then
    loadBrowseDisks()
  elseif event == "back" then
    backToFolder()
  elseif event == "search" then
    onSearch(arg)
  elseif event == "status" then
    noctalia.log(string.format(
      "game-launcher status: vista=%s tab=%s path=[%s] disks=%s entradas=%d visibles=%d browseSel=%d gameSel=%d err=[%s] juegos=%d filtrados=%d",
      viewMode, activeTab, browsePath, tostring(browseDisks), #browseEntries, #browseFiltered,
      browseIndex, selectedIndex, browseError, #games, #filtered))
  elseif event == "names" then
    -- Diagnóstico: lista los juegos realmente visibles (nombre[y runner])
    local out = {}
    for i, g in ipairs(filtered) do
      if i > 25 then
        table.insert(out, "…")
        break
      end
      table.insert(out, string.format("%d:%s[%s]", i, tostring(g.name), tostring(g.runner)))
    end
    noctalia.log("game-launcher names: " .. table.concat(out, " | "))
  elseif event == "launch" then
    -- Diagnóstico: abre la caja y lanza, sin ratón. Con texto busca por
    -- nombre; sin texto usa la fila seleccionada.
    local target
    if #arg == 0 then
      target = filtered[selectedIndex + 1]
    else
      for _, g in ipairs(filtered) do
        if tostring(g.name or ""):lower():find(arg:lower(), 1, true) then
          target = g
          break
        end
      end
    end
    if target then
      noctalia.log("game-launcher launch: " .. tostring(target.name))
      beginLaunch(target)
    else
      noctalia.log("game-launcher launch: sin objetivo para [" .. arg .. "]")
    end
  elseif event == "expand" then
    -- Diagnóstico: despliega las opciones del primer juego cuyo nombre
    -- contenga el texto (o las cierra si viene vacío).
    expandedId = nil
    if #arg > 0 then
      for _, g in ipairs(games) do
        if tostring(g.name or ""):lower():find(arg:lower(), 1, true) then
          expandedId = g.id
          local v = expandableVariants(g)
          noctalia.log(string.format("game-launcher expand: %s [%s] opciones=%d",
            tostring(g.name), tostring(g.runner), v and #v or 0))
          break
        end
      end
    else
      noctalia.log("game-launcher expand: ninguno")
    end
    render()
  elseif event == "nav" then
    -- Mando (gamepad) o CLI: mueve la selección de la vitrina o de
    -- "Examinar". Payload: up, down, left, right, enter, back, options,
    -- pageup, pagedown.
    if arg == "up" or arg == "prev" then
      if expandedId then stepLaunchOption(-1) else onKey("Up", true) end
    elseif arg == "down" or arg == "next" then
      if expandedId then stepLaunchOption(1) else onKey("Down", true) end
    elseif arg == "left" or arg == "tabprev" or arg == "tab_prev" then
      if expandedId then stepLaunchOption(-1) else cycleTab(-1) end
    elseif arg == "right" or arg == "tabnext" or arg == "tab_next" then
      if expandedId then stepLaunchOption(1) else cycleTab(1) end
    elseif arg == "back" or arg == "b" then
      -- Con las opciones abiertas, B las cierra; en "Examinar" sube de
      -- carpeta; en el resto no hace nada.
      if expandedId then closeLaunchOptions() else onKey("Left", true) end
    elseif arg == "enter" or arg == "select" or arg == "a" then
      if expandedId then confirmLaunchOption() else onKey("Return", true) end
    elseif arg == "options" or arg == "y" then
      if expandedId then closeLaunchOptions() else openLaunchOptions() end
    elseif arg == "pageup" or arg == "prevpage" then
      jumpRow(-PAGE_STEP)
    elseif arg == "pagedown" or arg == "nextpage" then
      jumpRow(PAGE_STEP)
    end
  end
end

function jumpRow(step)
  -- Salta una página de filas (LT/RT o L1/R1 del mando).
  if activeTab == TAB_BROWSE or activeTab == TAB_ADD then
    if #browseFiltered == 0 then return end
    browseIndex = browseIndex + step
    if browseIndex < 0 then browseIndex = 0 end
    if browseIndex >= #browseFiltered then browseIndex = #browseFiltered - 1 end
    revealBrowse()
    render()
    return
  end
  if #filtered == 0 then return end
  selectedIndex = selectedIndex + step
  if selectedIndex < 0 then selectedIndex = 0 end
  if selectedIndex >= #filtered then selectedIndex = #filtered - 1 end
  ensureSelVisible()
  revealSelected()
  ensureTicks(true)
  render()
end


function onSearch(value)
  searchText = value or ""
  if activeTab == TAB_BROWSE or activeTab == TAB_ADD then
    browseIndex = 0
    applyBrowseFilter()
    revealBrowse()
  else
    selectedIndex = 0
    filterGames(searchText)
    revealSelected()
  end
  render()
end

function onSubmitSearch()
  if activeTab == TAB_BROWSE or activeTab == TAB_ADD then
    browseActivate(browseFiltered[browseIndex + 1])
  elseif #filtered > 0 and selectedIndex >= 0 and selectedIndex < #filtered then
    beginLaunch(filtered[selectedIndex + 1])
  end
end

function onKey(chord, pressed)
  if not pressed then return end

  if activeTab == TAB_BROWSE or activeTab == TAB_ADD then
    -- En el paso del nombre, las flechas y Enter son del campo de texto.
    if activeTab == TAB_ADD and addExePath then return end
    if chord == "Up" then
      if #browseFiltered > 0 then
        browseIndex = browseIndex - 1
        if browseIndex < 0 then browseIndex = #browseFiltered - 1 end
        revealBrowse()
        render()
      end
    elseif chord == "Down" then
      if #browseFiltered > 0 then
        browseIndex = browseIndex + 1
        if browseIndex >= #browseFiltered then browseIndex = 0 end
        revealBrowse()
        render()
      end
    elseif chord == "Left" then
      backToFolder()
    elseif chord == "Return" then
      browseActivate(browseFiltered[browseIndex + 1])
    end
    return
  end

  -- Con las opciones abiertas, las flechas se mueven entre ellas en vez de
  -- cambiar de fila: es lo que está enseñando el panel en ese momento.
  if expandedId and (chord == "Up" or chord == "Down" or chord == "Left" or chord == "Right") then
    stepLaunchOption((chord == "Down" or chord == "Right") and 1 or -1)
    return
  end

  -- En la fila horizontal las cuatro flechas mueven el carrusel: la ventana
  -- se recentra en la caja seleccionada. Return abre el juego del centro.
  if viewMode == "jukebox" then
    if chord == "Left" or chord == "Up" then
      moveJukebox(-1)
    elseif chord == "Right" or chord == "Down" then
      moveJukebox(1)
    elseif chord == "Return" then
      if #filtered > 0 and selectedIndex >= 0 and selectedIndex < #filtered then
        beginLaunch(filtered[selectedIndex + 1])
      end
    end
    return
  end

  if chord == "Up" then
    if #filtered > 0 then
      selectedIndex = selectedIndex - 1
      if selectedIndex < 0 then selectedIndex = #filtered - 1 end
      ensureSelVisible()
      revealSelected()
      ensureTicks(true)
      render()
    end
  elseif chord == "Down" then
    if #filtered > 0 then
      selectedIndex = selectedIndex + 1
      if selectedIndex >= #filtered then selectedIndex = 0 end
      ensureSelVisible()
      revealSelected()
      ensureTicks(true)
      render()
    end
  elseif chord == "Return" then
    if expandedId then
      confirmLaunchOption()
    elseif #filtered > 0 and selectedIndex >= 0 and selectedIndex < #filtered then
      beginLaunch(filtered[selectedIndex + 1])
    end
  end
end

-- Rueda del ratón en la vista horizontal. Los paneles sí reciben onScroll
-- (vertical), así que cada paso mueve el carrusel como las flechas. En la
-- estantería vertical la rueda la gestiona el propio ui.scroll y este hook
-- no hace nada.
local lastScrollTime = 0
function onScroll(axis, steps, _startsGesture)
  pcall(function()
    noctalia.log("game-launcher scroll: axis=" .. tostring(axis) .. " steps=" .. tostring(steps))
  end)
  if axis ~= "vertical" then return end
  if activeTab ~= TAB_GAMES or viewMode ~= "jukebox" then return end
  if #filtered == 0 then return end
  local now = os.clock()
  if now - lastScrollTime < 0.12 then return end
  lastScrollTime = now
  local n = tonumber(steps) or 0
  if n > 0 then
    moveJukebox(1)
  elseif n < 0 then
    moveJukebox(-1)
  end
end
