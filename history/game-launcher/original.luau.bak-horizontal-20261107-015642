--- Plataforma de consola
---
--- Casi todos los juegos muestran en la cabecera de su caja el runner con el
--- que se abren ("DESKTOP", "Faugus", ...). Los ports de PS4 de la lista
--- llevan en su lugar el logo de PlayStation y "PS4": el juego viene de la
--- consola, no de una tienda de PC. Solo cambia la cabecera de estos dos.
---------------------------------------------------------------------------

local PS4_LOGO = homeDir() .. "/.local/share/noctalia/game-platforms/ps4.png"

local PLATFORM_BADGES = {
  ["ctr-nitro-fueled"] = { label = "PS4", icon = PS4_LOGO },
  ["infamous-second-son"] = { label = "PS4", icon = PS4_LOGO },
}

-- Cabecera de la caja de un juego: plataforma si la tiene, si no el runner.
local function gameBadge(g)
  local platform = PLATFORM_BADGES[g.id]
  if platform then
    return { label = platform.label, icon = platform.icon, color = "#0070d1" }
  end
  local meta = runnerMeta[g.runner] or { glyph = "app-window", color = "on_surface_variant" }
  return { label = runnerDisplayName(g.runner), glyph = meta.glyph, color = meta.color }
end

-- Logo de la plataforma si la imagen existe; si no, el glifo del runner.
local function badgeGlyph(badge, size)
  if badge.icon and noctalia.fileExists(badge.icon) then
    return ui.image({
      path = badge.icon,
      width = math.max(1, math.floor(size * 1.29)),
      height = size,
      fit = "contain",
    })
  end
  return ui.glyph({ name = badge.glyph or "app-window", size = size, color = badge.color })
end

---------------------------------------------------------------------------
--- Opciones de lanzamiento: un mismo juego puede abrirse de varias maneras.
--- La variante lleva su sufijo entre paréntesis ("Stellar Blade (gamescope)"
--- junto a "Stellar Blade"), así que comparando el título base se enlazan
--- automáticamente: al pulsar el título normal aparecen todas las formas.
---------------------------------------------------------------------------

-- Texto dentro del paréntesis: "gamescope", "heroic", ...
local function variantLabel(name)
  return tostring(name or ""):match("%((.-)%)") or tostring(name or "")
end

local function titleCase(s)
  return (tostring(s or ""):gsub("^%l", string.upper))
end

-- Solo el título plano despliega; una variante se abre directamente.
-- Devuelve nil cuando no hay nada más que ofrecer.
local function expandableVariants(g)
  if isVariant(g.name) then return nil end
  local list = variantsByBase[baseTitle(g.name)]
  if not list or #list < 2 then return nil end
  local out = {}
  for _, other in ipairs(list) do
    if other.id ~= g.id then table.insert(out, other) end
  end
  if #out == 0 then return nil end
  return out
end

-- Id de la fila base de una variante: para abrir su caja antes de lanzarla.
local function baseIdOf(g)
  if not isVariant(g.name) then return g.id end
  local base = baseTitle(g.name)
  for _, cand in ipairs(games) do
    if cand.id ~= g.id and not isVariant(cand.name) and baseTitle(cand.name) == base then
      return cand.id
    end
  end
  return nil
end

-- Se muestra sobre la lista, fuera del contenedor con scroll: así las filas
-- mantienen su altura fija y la rueda sigue calculando bien la selección.
-- Solo existe mientras haya un expandedId visible en la lista filtrada.
local function renderLaunchOptions()
  if not expandedId then return nil end

  local target, variants
  for _, g in ipairs(filtered) do
    if g.id == expandedId then
      target = g
      variants = expandableVariants(g)
      break
    end
  end
  if not target or not variants then return nil end
  -- El foco puede quedar fuera si la lista cambió por debajo.
  local total = 1 + #variants
  if optionIndex < 0 or optionIndex > total - 1 then optionIndex = 0 end

  local buttons = {
    ui.label({
      text = target.name,
      fontSize = 12,
      fontWeight = "bold",
      color = "on_surface_variant",
      maxLines = 1,
    }),
    ui.button({
      text = "Con " .. titleCase(runnerDisplayName(target.runner)),
      glyph = (runnerMeta[target.runner] or {}).glyph or "app-window",
      variant = optionIndex == 0 and "primary" or "outline",
      onClick = function() beginLaunch(target) end,
    }),
  }
  for i, v in ipairs(variants) do
    table.insert(buttons, ui.button({
      text = "Con " .. variantLabel(v.name),
      glyph = (runnerMeta[v.runner] or {}).glyph or "grid-dots",
      variant = optionIndex == i and "primary" or "outline",
      onClick = function() beginLaunch(v, baseIdOf(v)) end,
    }))
  end
  table.insert(buttons, ui.button({
    glyph = "x",
    variant = "ghost",
    onClick = function() closeLaunchOptions() end,
  }))
  return ui.row({ align = "center", gap = 8, paddingH = 10, paddingV = 6, radius = 8 }, buttons)
end

-- Las opciones visibles, si las hay. Devuelve el juego y sus variantes.
local function launchOptionsTarget()
  if not expandedId then return nil end
  for _, g in ipairs(filtered) do
    if g.id == expandedId then
      local variants = expandableVariants(g)
      if variants then return g, variants end
      return nil
    end
  end
  return nil
end

-- Y en el mando: abre las opciones del juego seleccionado. Sin opciones no
-- hace nada, para no dejar sin efecto un botón que parece una acción.
function openLaunchOptions()
  local g = filtered[selectedIndex + 1]
  if not g then return end
  if not expandableVariants(g) then return end
  expandedId = g.id
  optionIndex = 0
  render()
end

function closeLaunchOptions()
  if not expandedId then return end
  expandedId = nil
  optionIndex = 0
  render()
end

function stepLaunchOption(step)
  local _, variants = launchOptionsTarget()
  if not variants then return end
  local total = 1 + #variants
  optionIndex = (optionIndex + step) % total
  if optionIndex < 0 then optionIndex = optionIndex + total end
  render()
end

function confirmLaunchOption()
  local g, variants = launchOptionsTarget()
  if not g then return end
  if optionIndex == 0 then
    beginLaunch(g)
  else
    local v = variants[optionIndex]
    if v then beginLaunch(v, baseIdOf(v)) end
  end
end

local function renderHeader()
  return ui.row({ align = "center", gap = 8 }, {
    ui.glyph({ name = "device-gamepad-2", size = 20, color = "primary" }),
    ui.label({ text = "Game Launcher", fontSize = 18, fontWeight = "bold", color = "primary", flexGrow = 1 }),
    -- Cuenta lo que la lista enseña: una variante plegada en su base no es
    -- una fila más.
    ui.label({ text = "(" .. #filtered .. " games)", color = "on_surface_variant", fontSize = 12 }),
    ui.button({ glyph = "reload", variant = "ghost", onClick = "onRescan" }),
    ui.button({ glyph = "close", variant = "ghost", onClick = "onClose" }),
  })
end

local function renderSearchBar()
  return ui.row({ align = "center", gap = 8 }, {
    ui.glyph({ name = "search", size = 14, color = "on_surface_variant" }),
    -- ui.input is uncontrolled: the key is what empties it, so it is
    -- derived from the tab as well as the scan counter.
    ui.input({
      key = "search_" .. scanCounter .. "_" .. activeTab,
      placeholder = (activeTab == TAB_BROWSE and "Buscar en esta carpeta…")
        or (activeTab == TAB_ADD and "Buscar un .exe…")
        or "Search games…",
      onChange = "onSearch",
      onSubmit = "onSubmitSearch",
      value = searchText,
      flexGrow = 1,
      focus = true,
    }),
    ui.button({ glyph = "filter", variant = "ghost", visible = false }),
  })
end

local function renderStatus()
  if loading then
    return ui.row({ align = "center", justify = "center", flexGrow = 1 }, {
      ui.label({ text = "Scanning for games…", color = "on_surface_variant" }),
    })
  end
  if errorMsg ~= "" then
    return ui.column({ align = "center", justify = "center", flexGrow = 1, gap = 12 }, {
      ui.glyph({ name = "alert-circle", size = 40, color = "error" }),
      ui.label({ text = errorMsg, color = "error", maxWidth = 400, textAlign = "center" }),
      ui.button({ text = "Retry", variant = "primary", onClick = "onRescan" }),
    })
  end
  if #filtered == 0 then
    return ui.row({ align = "center", justify = "center", flexGrow = 1 }, {
      ui.label({
        text = #games == 0 and "No games found. Click the reload button to scan." or "No games match your search.",
        color = "on_surface_variant",
      }),
    })
  end
  return nil
end

-- ---------------------------------------------------------------------------
-- Vitrina vertical (estilo NonDot GameLibrary): cada juego es una caja de
-- verdad -lomo, cabecera con la plataforma y carátula- apoyada en una balda
-- de cristal, con el nombre al lado. Al pasar el ratón la caja crece 1.25x,
-- se enciende su balda y las demás se atenúan, como en el jukebox del repo.
-- El tamaño lo interpola onFrameTick: la UI de Noctalia no anima sola.
-- ---------------------------------------------------------------------------

local COVER_H = 160         -- alto de la caja en reposo
local COVER_GROW = 1.25     -- lo que crece al pasar el ratón (como el repo)
local COVER_RATIO = 0.693   -- proporción de una caja de juego (2:3)
local CASE_W_MAX = math.floor(COVER_H * COVER_GROW * COVER_RATIO)
local STAND_W = CASE_W_MAX + 54

local function focusedGame()
  local g = filtered[selectedIndex + 1]
  if hoveredId then
    for _, h in ipairs(filtered) do
      if h.id == hoveredId then return h end
    end
  end
  return g
end

local function coverFor(g)
  local cp = (g.cover and #g.cover > 0) and g.cover or nil
  if not cp then
    if g.runner == "steam" then
      cp = steamCoverDir .. "/" .. g.id .. ".jpg"
    elseif g.runner == "heroic" then
      cp = heroicCoverDir .. "/" .. g.id .. ".jpg"
    end
  end
  return cp
end

local function coverFileExists(path)
  if not path then return false end
  local hit = coverExists[path]
  if hit == nil then
    hit = noctalia.fileExists(path)
    coverExists[path] = hit
  end
  return hit
end

-- ---------------------------------------------------------------------------
-- Apertura de la caja (jukebox-open): al pulsar un juego, la tapa -que es la
-- propia portada- gira sobre la bisagra izquierda hasta quedar de canto,
-- aparece la bandeja y el disco (la carátula recortada en círculo) gira
-- mientras arranca el juego. La UI no sabe rotar, así que el disco se sirve
-- como fotogramas pre-rotados con ImageMagick, generados la primera vez.
-- ---------------------------------------------------------------------------

local DISC_FRAMES = 24        -- 360 / 24 = 15° por fotograma
local DISC_MS_PER_FRAME = 50  -- 24 fotogramas = 1,2 s por vuelta
local LID_MS = 620            -- lo que tarda la tapa en abrirse
local LAUNCH_MS = 2150        -- apertura + giro antes de lanzar el juego

local launchingId = nil        -- id que se va a lanzar (puede ser una variante)
local launchingCaseId = nil    -- id de la fila cuya caja se abre (normalmente la base)
local launchElapsed = 0
local launchLid = 0
local launchRenderAcc = 0
local discReady = {}          -- id -> los fotogramas ya existen
local discPending = {}        -- id -> se están generando

local function discDirFor(id)
  return discCacheDir .. "/" .. id
end

local function discFramePath(id, index)
  return discDirFor(id) .. "/f" .. index .. ".png"
end

local function discFramesReady(id)
  if discReady[id] then return true end
  if noctalia.fileExists(discFramePath(id, DISC_FRAMES - 1)) then
    discReady[id] = true
    return true
  end
  return false
end

-- El script se escribe una vez en la caché y se reutiliza: pasar el ángulo
-- como argumento desde Luau obligaría a escapar comillas dentro de comillas.
local DISC_SCRIPT = [==[
# Fotogramas pre-rotados del disco de un juego.
# $1 = carátula (puede no existir)   $2 = carpeta de salida
cover="$1"
out="$2"
mkdir -p "$out" || exit 1

# Marca de con qué portada se generó este disco: si cambia, el plugin tira
# los fotogramas y los vuelve a hacer.
printf '%s' "$cover" > "$out/src"

if [ ! -f "$out/base.png" ]; then
  if [ -n "$cover" ] && [ -f "$cover" ]; then
    magick "$cover" -resize "256x256^" -gravity center -extent 256x256 \
      \( -size 256x256 xc:black -fill white -draw "circle 128,128 128,6" \) \
      -alpha off -compose CopyOpacity -composite \
      -fill none -stroke "rgba(255,255,255,0.85)" -strokewidth 3 -draw "circle 128,128 124,128" \
      -fill none -stroke "rgba(0,0,0,0.30)" -strokewidth 2 -draw "circle 128,128 112,128" \
      -stroke none -fill "#080a0d" -draw "circle 128,128 128,116" \
      "$out/base.png" || exit 1
  else
    magick -size 256x256 xc:none \
      -fill "#1b2028" -stroke "rgba(255,255,255,0.45)" -strokewidth 2 \
      -draw "circle 128,128 128,6" \
      -stroke none -fill "#080a0d" -draw "circle 128,128 128,116" \
      "$out/base.png" || exit 1
  fi
fi

i=0
while [ "$i" -lt 24 ]; do
  if [ ! -f "$out/f$i.png" ]; then
    magick "$out/base.png" -background none -rotate $((i * 15)) \
      -gravity center -extent 256x256 "$out/f$i.png" || exit 1
  fi
  i=$((i + 1))
done
]==]

local function ensureDiscScript()
  local path = discCacheDir .. "/make-disc.sh"
  if noctalia.fileExists(path) and noctalia.readFile(path) == DISC_SCRIPT then
    return path
  end
  pcall(noctalia.writeFile, path, DISC_SCRIPT)
  return path
end

prepareDisc = function(g, force)
  if not g then return end
  local dir = discDirFor(g.id)
  local cover = coverFor(g) or ""

  -- El disco apunta en "$dir/src" con qué portada se hizo. Si la portada ha
  -- cambiado (o no hay marca) los fotogramas viejos ya no valen.
  if not force and discFramesReady(g.id) then
    local stamp = nil
    pcall(function() stamp = noctalia.readFile(dir .. "/src") end)
    if stamp ~= cover then force = true end
  end

  if force then
    discReady[g.id] = nil
    discPending[g.id] = nil
  elseif discPending[g.id] or discFramesReady(g.id) then
    return
  end
  if discPending[g.id] then return end

  discPending[g.id] = true
  pcall(noctalia.mkdirAll, dir)
  local prefix = ""
  if force then prefix = "rm -rf " .. shellQuote(dir) .. " && " end
  local cmd = prefix .. "sh " .. shellQuote(ensureDiscScript()) .. " " .. shellQuote(cover) .. " " .. shellQuote(dir)
  local ok = noctalia.runAsync(cmd, function(res)
    discPending[g.id] = nil
    if res and res.exitCode == 0 and noctalia.fileExists(discFramePath(g.id, DISC_FRAMES - 1)) then
      discReady[g.id] = true
    else
      noctalia.log("disc: no se pudo generar el disco de " .. tostring(g.id)
        .. ": " .. tostring(res and (res.stderr or res.stdout) or "?"):sub(1, 200))
    end
  end)
  if not ok then
    discPending[g.id] = nil
    noctalia.log("disc: no se pudo arrancar make-disc.sh")
  end
end

-- El disco tal cual: fotograma girando si ya está cacheado, disco quieto
-- mientras se genera y, como último recurso, un círculo vacío.
local function renderDisc(g, size)
  local s = math.max(16, math.floor(size))
  local id = g.id
  if discFramesReady(id) then
    local frame = math.floor(launchElapsed / DISC_MS_PER_FRAME) % DISC_FRAMES
    return ui.image({
      path = discFramePath(id, frame),
      width = s,
      height = s,
      fit = "contain",
    })
  end
  local base = discDirFor(id) .. "/base.png"
  if noctalia.fileExists(base) then
    return ui.image({ path = base, width = s, height = s, fit = "contain" })
  end
  return ui.column({
    width = s,
    height = s,
    radius = math.floor(s / 2),
    fill = "#1b2028",
    border = "outline/0.6",
    borderWidth = 1,
    align = "center",
    justify = "center",
  }, {
    ui.glyph({ name = "disc", size = math.floor(s * 0.45), color = "on_surface_variant" }),
  })
end

-- La caja abierta: la tapa se estrecha hasta dejar sólo su canto y la
-- bandeja, con el disco girando, ocupa el resto. El ancho total no cambia,
-- así que la balda y el resto de la fila no se mueven.
local function renderOpenCase(g, meta, cp, cw, ch)
  local badge = gameBadge(g)
  local p = launchLid
  local lidW = math.max(4, math.floor(cw * (1 - 0.80 * p)))
  local trayW = math.max(1, cw - lidW)
  local bannerH = math.max(10, math.floor(ch * 0.075))

  local lidChildren = {}
  if lidW >= 14 then
    local innerW = math.max(2, lidW - 4)
    local innerH = math.max(2, ch - bannerH - 4)
    local bannerChildren = {
      badgeGlyph(badge, math.max(7, math.floor(bannerH * 0.6))),
    }
    if lidW >= 46 then
      table.insert(bannerChildren, ui.label({
        text = string.upper(badge.label or ""),
        fontSize = math.max(6, math.floor(bannerH * 0.46)),
        color = "on_surface",
        maxLines = 1,
      }))
    end
    local art
    if cp and coverFileExists(cp) then
      -- "stretch" y no "cover": al girar, la portada se estrecha (escorzo)
      -- en vez de recortarse por el centro.
      art = ui.image({ path = cp, width = innerW, height = innerH, fit = "stretch" })
    else
      art = ui.column({
        width = innerW,
        height = innerH,
        fill = "surface_variant",
        align = "center",
        justify = "center",
      }, {
        ui.glyph({ name = meta.glyph, size = math.max(8, math.floor(lidW * 0.5)), color = meta.color }),
      })
    end
    table.insert(lidChildren, ui.row({
      height = bannerH,
      fill = "#0d1117",
      align = "center",
      justify = "center",
      gap = 3,
    }, bannerChildren))
    table.insert(lidChildren, art)
  else
    -- De canto: se ve el canto de plástico de la tapa.
    table.insert(lidChildren, ui.box({
      width = math.max(1, lidW - 4),
      height = math.max(2, ch - 4),
      radius = 1,
      fill = "#151a22",
    }))
  end

  local lid = ui.column({
    width = lidW,
    height = ch,
    gap = 0,
    radius = 4,
    fill = "#0b0e12",
    align = "center",
    justify = "center",
  }, lidChildren)

  local trayChildren = {}
  local pad = math.max(4, math.floor(trayW * 0.09))
  local plateW = math.max(2, trayW - pad * 2 - 2)
  local plateH = math.max(2, ch - pad * 2 - 2)
  local discSize = math.min(plateW * 0.94, plateH * 0.94)
  if trayW >= 40 and discSize >= 24 then
    table.insert(trayChildren, ui.column({
      width = plateW,
      height = plateH,
      fill = "#161c25",
      radius = 3,
      border = "outline/0.45",
      borderWidth = 1,
      align = "center",
      justify = "center",
    }, { renderDisc(g, discSize) }))
  end

  local tray = ui.column({
    width = trayW,
    height = ch,
    fill = "#090c11",
    radius = 3,
    border = "outline/0.55",
    borderWidth = 1,
    align = "center",
    justify = "center",
    padding = pad,
  }, trayChildren)

  return ui.row({
    width = cw,
    height = ch,
    gap = 0,
    radius = 4,
    border = "primary",
    borderWidth = 2,
  }, { lid, tray })
end


-- Caja cerrada (cabecera de plataforma + carátula) a un tamaño dado. La usan
-- la estantería vertical y la fila horizontal del modo jukebox.
local function renderCaseBox(g, meta, cp, cw, ch, focused)
  local badge = gameBadge(g)
  local bannerH = math.max(12, math.floor(ch * 0.085))
  local innerW = cw - 4
  local innerH = ch - bannerH - 4

  local art
  if cp and coverFileExists(cp) then
    art = ui.image({
      path = cp,
      width = innerW,
      height = innerH,
      radius = 0,
      fit = "cover",
    })
  else
    art = ui.column({
      width = innerW,
      height = innerH,
      fill = "surface_variant",
      align = "center",
      justify = "center",
    }, {
      ui.glyph({ name = meta.glyph, size = 22, color = meta.color }),
    })
  end

  return ui.row({
    width = cw,
    height = ch,
    gap = 0,
    radius = 4,
    fill = "#0b0e12",
    border = focused and "primary" or "outline/0.55",
    borderWidth = focused and 2 or 1,
  }, {
    ui.column({ flexGrow = 1, gap = 0 }, {
      ui.row({
        height = bannerH,
        fill = "#0d1117",
        align = "center",
        justify = "center",
        gap = 3,
      }, {
        badgeGlyph(badge, math.max(8, math.floor(bannerH * 0.62))),
        ui.label({
          text = string.upper(badge.label or ""),
          fontSize = math.max(6, math.floor(bannerH * 0.46)),
          color = "on_surface",
          maxLines = 1,
        }),
      }),
      art,
    }),
  })
end

local function renderGameRow(g, index)
  local meta = runnerMeta[g.runner] or { glyph = "app-window", color = "on_surface_variant" }
  local badge = gameBadge(g)
  local launching = launchingId ~= nil
  local isLaunching = launchingCaseId == g.id
  local focus = focusedGame()
  local focused = (focus ~= nil and focus.id == g.id) or isLaunching
  local p = anim[g.id] or 0
  local ch = math.floor(COVER_H * (1 + (COVER_GROW - 1) * p))
  local cw = math.floor(ch * COVER_RATIO)
  local cp = coverFor(g)

  -- La caja: cabecera con la plataforma y carátula, como las cajas que
  -- dibuja GameCase.qml en el repo. Al lanzar se sustituye por la caja
  -- abierta: la tapa gira, la bandeja aparece y el disco gira.
  local caseWidget
  if isLaunching then
    caseWidget = renderOpenCase(g, meta, cp, cw, ch)
  else
    caseWidget = renderCaseBox(g, meta, cp, cw, ch, focused)
  end

  local variants = expandableVariants(g)
  -- Un título con varias formas de abrirse no lanza nada al pulsarlo: deja
  -- ver sus opciones. Los demás juegos se abren con la caja abriéndose.
  local function activate()
    if launching then return end
    if variants then
      expandedId = g.id
      render()
    else
      beginLaunch(g)
    end
  end

  local info = {
    badgeGlyph(badge, 12),
    ui.label({ text = badge.label, fontSize = 11, color = "on_surface_variant" }),
  }
  if isLaunching then
    info = {
      ui.glyph({ name = "disc", size = 12, color = "primary" }),
      ui.label({ text = "Abriendo…", fontSize = 11, color = "primary/0.9" }),
    }
  elseif variants then
    table.insert(info, ui.label({
      text = "· " .. (1 + #variants) .. " formas de abrir",
      fontSize = 11,
      color = "primary/0.9",
    }))
  end

  -- Balda de cristal: canto iluminado y filo tenue debajo.
  local shelf = ui.column({ width = cw + 54, align = "center", gap = 2 }, {
    ui.box({
      width = cw + 34,
      height = 3,
      radius = 2,
      fill = focused and "primary" or "outline/0.55",
    }),
    ui.box({ width = cw + 54, height = 1, fill = "outline/0.28" }),
  })

  return ui.row({
    key = g.id,
    height = ROW_H - 6,
    align = "center",
    gap = 18,
    paddingH = 14,
    radius = 12,
    fill = focused and "primary/0.10" or "primary/0",
    border = "primary/0.35",
    borderWidth = focused and 1 or 0,
    opacity = isLaunching and 1 or (launching and 0.25 or (focused and 1 or (1 - 0.45 * dim))),
    onHover = "onCardHover",
    onClick = activate,
