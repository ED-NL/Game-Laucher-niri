-- Quoting for paths that get pasted into a shell command.
local function shellQuote(s)
  return '"' .. tostring(s):gsub('[\\$"`]', '\\%0') .. '"'
end

local function homeDir()
  local h = noctalia.getenv("HOME")
  if h and #h > 0 then return h end
  return "/home/" .. (noctalia.getenv("USER") or "user")
end

local function isValidProtocol(cmd)
  -- desktop:// carries an absolute path to a .desktop entry, which is how
  -- games living only in the application menu are launched.
  local protocols = { "steam://", "lutris:", "heroic://", "desktop://" }
  for _, p in ipairs(protocols) do
    if cmd:sub(1, #p) == p then
      local rest = cmd:sub(#p + 1)
      if rest:match("^[%w_%-%.%/]+$") then return true end
    end
  end
  return false
end

local function isRunnerEnabled(runner)
  -- val == nil means the key is not registered (manifest not picked up
  -- yet, or an older export). Treat it as enabled rather than hiding
  -- every game of that runner; a registered key still wins either way.
  local ok, val = pcall(noctalia.getConfig, runner .. "_enabled")
  if not ok then return true end
  if val == nil then return true end
  return val == true or val == "true"
end

local function filterByRunner(g)
  return isRunnerEnabled(g.runner)
end

local function launchGame(id)
  -- Se busca en la biblioteca completa y no en la lista visible: una
  -- variante plegada (Stellar Blade (gamescope)) no está en filtered, pero
  -- es una de las opciones que la barra ofrece para su base.
  for _, g in ipairs(games) do
    if g.id == id and g.run_command and #g.run_command > 0 and isValidProtocol(g.run_command) then
      if g.run_command:sub(1, 10) == "desktop://" then
        -- gio runs the entry's own Exec line, field codes and all.
        noctalia.runAsync("gio launch " .. shellQuote(g.run_command:sub(11)))
      else
        noctalia.runAsync('xdg-open "' .. g.run_command .. '"')
      end
      onClose()
      return
    end
    -- Juego local que vive en un disco: se abre con la aplicación de Faugus.
    if g.id == id and g.runner == "external" and g.exe and #g.exe > 0 then
      launchExeWithFaugus(g.exe, g.name)
      return
    end
  end
end

--------------------------------------------------------------------------
-- Examinar: buscar un .exe en el disco y arrancarlo con umu-run
--
-- Faugus itself cannot launch a file that is not in its library: --game
-- looks the id up in games.json and silently returns when it is absent,
-- and --shortcut only opens a window. umu-run is the engine Faugus runs
-- underneath, so it is driven directly and Faugus' library is left alone.
--------------------------------------------------------------------------

-- Faugus' own runner, shipped with the native package.
local function umuBinary()
  return homeDir() .. "/.local/share/faugus-launcher/umu-run"
end

-- Mirrors Faugus' launch builder: the same Proton name it hands umu, the
-- same Steam compatibility tools, the same container mode. UMU_RUNTIME is
-- deliberately absent - Faugus never sets it either.
local function faugusEnv(prefix)
  local components = homeDir() .. "/.local/share/faugus-launcher/components"
  local parts = {
    "WINEPREFIX=" .. shellQuote(prefix),
    "PROTONPATH=" .. shellQuote("Proton-CachyOS Latest"),
    "UMU_USE_STEAM=0",
    "UMU_CONTAINER_NSENTER=1",
    "UMU_SKIP_SBOX=1",
    "PROTON_USE_SBOX=0",
  }
  if noctalia.fileExists(components .. "/eac") then
    table.insert(parts, "PROTON_EAC_RUNTIME=" .. shellQuote(components .. "/eac"))
  end
  if noctalia.fileExists(components .. "/be") then
    table.insert(parts, "PROTON_BATTLEYE_RUNTIME=" .. shellQuote(components .. "/be"))
  end
  return parts
end

-- A prefix per game, so a broken run never poisons another one. umu
-- creates the directory on the first launch.
local function prefixFor(exePath)
  -- Para evitar rutas demasiado largas o caracteres extraños, 
  -- usamos un slug simple basado en el nombre del archivo.
  local name = exePath:match("([^/]+)$") or "game"
  local slug = name:lower():gsub("%.exe$", "")
  slug = slug:gsub("[^%w%-]+", "-"):gsub("^[%-]+", ""):gsub("[%-$]+", "")
  if slug == "" then slug = "game" end
  -- Faugus usa /home/spawnenl/Faugus por defecto según su config.json
  return homeDir() .. "/Faugus/" .. slug
end

launchExeWithFaugus = function(exePath, gameName)
  -- Se abre con el mismo lanzador que usa el explorador de archivos
  -- (~/.local/bin/faugus-open). Ese script arranca el juego con gamescope
  -- (ventana propia a 1920x1080, sin que el mosaico de niri lo rompa),
  -- exporta WINEPREFIX/PROTONPATH para que Faugus no los pise con el
  -- "default-runner" de config.json, y borra el crash.info que hace que
  -- Uncharted pregunte por el "modo seguro" y se cierre.
  local opener = homeDir() .. "/.local/bin/faugus-open"
  if not noctalia.fileExists(opener) then
    browseError = "No se encontró faugus-open en " .. opener
    render()
    return
  end

  -- Se arranca con el cwd en la carpeta del juego, como cuando se abre a
  -- mano; el lanzador se encarga de las comillas de la ruta.
  local dir = exePath:match("^(.*)/[^/]+$") or ""
  local cmd = "cd " .. shellQuote(dir) .. " && setsid -f "
    .. shellQuote(opener) .. " " .. shellQuote(exePath)

  local ok, err = pcall(function()
    return noctalia.runAsync(cmd, function(res)
      if res and res.exitCode ~= 0 then
        noctalia.log("faugus-launcher exit " .. tostring(res.exitCode) .. ": "
          .. tostring(res.stderr or res.stdout or ""):sub(1, 300))
      end
    end)
  end)

  if not ok or err == false then
    browseError = "No se pudo arrancar el juego con Faugus."
    noctalia.log("launchExeWithFaugus: " .. tostring(err))
    render()
    return
  end
  onClose()
end

local function applyBrowseFilter()
  if searchText == "" then
    browseFiltered = browseEntries
  else
    local needle = searchText:lower()
    local matches = {}
    for _, entry in ipairs(browseEntries) do
      if entry.name:lower():find(needle, 1, true) then
        table.insert(matches, entry)
      end
    end
    browseFiltered = matches
  end
  if browseIndex > #browseFiltered - 1 then browseIndex = #browseFiltered - 1 end
  if browseIndex < 0 then browseIndex = 0 end
end

local function joinPath(dir, name)
  if dir == "/" then return "/" .. name end
  return dir .. "/" .. name
end

loadBrowseDir = function(path)
  -- El listado va por un proceso aparte: hacer fileInfo() de cada entrada
  -- aquí dentro agotaba el presupuesto de 25 ms del callback (una carpeta
  -- como un árbol de compilación de Wine lo desbordaba y Noctalia acababa
  -- desactivando el script).
  local token = browseScanToken + 1
  browseScanToken = token
  browseDisks = false
  browsePath = path
  browseEntries = {}
  browseFiltered = {}
  browseIndex = 0
  browseError = ""
  browseLoading = true
  render()
  -- Directorios y ejecutables, una línea por entrada: "d<TAB>nombre".
  local cmd = "find " .. shellQuote(path)
    .. " -mindepth 1 -maxdepth 1 \\( -type d -o -iname '*.exe' \\)"
    .. " -printf '%y\\t%f\\n' 2>/dev/null | LC_ALL=C sort -f"
  local ok = noctalia.runAsync(cmd, function(res)
    if browseScanToken ~= token then return end -- sustituido por otra lectura
    browseLoading = false
    local list = {}
    for line in (res.stdout or ""):gmatch("[^\n]+") do
      local kind, name = line:match("^(%a)\t(.+)$")
      if kind and name and name ~= "." and name ~= ".." then
        table.insert(list, { name = name, path = joinPath(path, name), isDir = kind == "d" })
      end
    end
    if #list == 0 and (res.exitCode or 1) ~= 0 then
      browseError = "No se pudo leer " .. path
      if res.stderr and #res.stderr > 0 then
        browseError = browseError .. ": " .. res.stderr:sub(1, 120)
      end
    end
    browsePath = path
    browseEntries = list
    browseIndex = 0
    applyBrowseFilter()
    revealBrowse()
    render()
  end)
  if not ok then
    browseLoading = false
    browseError = "No se pudo listar " .. path
    render()
  end
end

local function formatSize(bytes)
  local value = tonumber(bytes) or 0
  local units = { "B", "KB", "MB", "GB", "TB" }
  local index = 1
  while value >= 1024 and index < #units do
    value = value / 1024
    index = index + 1
  end
  if index == 1 then return string.format("%d %s", value, units[index]) end
  return string.format("%.1f %s", value, units[index])
end

-- Mount points that belong to the running system rather than to a disk the
-- user would want to browse. "/" matches by equality alone, otherwise
-- every path would start with it.
local SYSTEM_MOUNTS = { "/boot", "/var", "/usr", "/etc", "/opt", "/snap", "/nix", "/tmp" }

local function isSystemMount(mp)
  if not mp or mp == "" then return true end -- not mounted at all
  if mp:sub(1, 1) == "[" then return true end -- [SWAP] and friends
  if mp == "/" then return true end -- the system itself
  -- Everything under /run is session plumbing (tmpfs, credentials) apart
  -- from /run/media, which is where removable disks land.
  if mp == "/run" then return true end
  if mp:find("/run/", 1, true) == 1 and mp:find("/run/media/", 1, true) ~= 1 then
    return true
  end
  for _, root in ipairs(SYSTEM_MOUNTS) do
    if mp == root or mp:find(root .. "/", 1, true) == 1 then return true end
  end
  return false
end

local function collectDisks(devices, list)
  for _, dev in ipairs(devices) do
    if dev.children then collectDisks(dev.children, list) end
    if dev.mountpoint and not isSystemMount(dev.mountpoint) then
      local label = (dev.label and #dev.label > 0) and dev.label or (dev.name or "?")
      table.insert(list, {
        name = label,
        path = dev.mountpoint,
        isDir = true,
        detail = formatSize(dev.size),
      })
    end
  end
end

loadBrowseDisks = function()
  browseDisks = true
  browsePath = ""
  browseEntries = {}
  browseFiltered = {}
  browseIndex = 0
  browseError = ""
  browseLoading = true
  local token = browseScanToken + 1
  browseScanToken = token
  render()
  local ok = noctalia.runAsync("lsblk -b -J -o NAME,SIZE,LABEL,MOUNTPOINT,TYPE", function(res)
    if browseScanToken ~= token then return end -- superseded by a newer read
    browseLoading = false
    local list = {}
    local decoded, data = pcall(noctalia.json.decode, res.stdout or "")
    if res.exitCode == 0 and decoded and data and data.blockdevices then
      collectDisks(data.blockdevices, list)
      browseEntries = list
      browseError = ""
    else
      browseError = "No se pudo leer los discos."
      if res.stderr and #res.stderr > 0 then
        browseError = browseError .. ": " .. res.stderr:sub(1, 120)
      end
    end
    browseIndex = 0
    applyBrowseFilter()
    revealBrowse()
    render()
  end)
  if not ok then
    browseLoading = false
    browseError = "No se pudo arrancar lsblk."
    render()
  end
end

local function browseActivate(entry)
  if not entry then return end
  if entry.isDir then
    loadBrowseDir(entry.path)
  elseif activeTab == TAB_ADD then
    -- No se añade al vuelo: se pide el nombre para poder buscar la portada.
    addExePath = entry.path
    addName = nameForAdd(entry.path)
    render()
  else
    launchExeWithFaugus(entry.path, entry.name)
  end
end

local function backToFolder()
  if browseDisks then
    loadBrowseDir(homeDir())
  elseif browsePath == "" or browsePath == "/" then
    loadBrowseDisks()
  else
    local parent = browsePath:match("^(.*)/[^/]+$")
    if not parent or parent == "" then parent = "/" end
    loadBrowseDir(parent)
  end
end

