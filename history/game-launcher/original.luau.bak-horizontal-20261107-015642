local function renderJukebox()
  local first, last = jukeboxRange()
  local cards = {}
  for i = first, last do
    table.insert(cards, renderJukeboxCard(filtered[i], i - 1))
  end

  local strip = ui.row({ align = "center", justify = "center", gap = 10, flexGrow = 1 }, {
    ui.button({
      glyph = "arrow-left",
      variant = "ghost",
