-- limpiar). Se usa tal cual: aquí no se busca nada en Steam.
local function bundledCover(file)
  local ok, dir = pcall(noctalia.pluginDataDir)
  if not (ok and dir and #dir > 0) then return "" end
  local p = dir .. "/covers/" .. file
  if noctalia.fileExists(p) then return p end
  return ""
end

