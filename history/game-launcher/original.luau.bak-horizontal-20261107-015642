--- Juegos añadidos desde la pestaña "Añadir juego"
---
--- Viven en un JSON dentro del directorio de datos del plugin, así que
--- sobreviven a un reescaneo y a reiniciar Noctalia. El .exe se abre con
--- Faugus, igual que los juegos externos de la lista de arriba.
---------------------------------------------------------------------------

local externalExtra = {}

local function externalStorePath()
  local ok, dir = pcall(noctalia.pluginDataDir)
  if ok and dir and #dir > 0 then return dir .. "/external-games.json" end
  return nil
end

local function loadExternalExtra()
  local path = externalStorePath()
  if not path or not noctalia.fileExists(path) then return end
  local text = noctalia.readFile(path)
  if not text or #text == 0 then return end
  local ok, data = pcall(noctalia.json.decode, text)
  if ok and type(data) == "table" then
    for _, g in ipairs(data) do
      if type(g) == "table" and g.exe and g.name then
        table.insert(externalExtra, g)
      end
    end
  end
end

local function saveExternalExtra()
  local path = externalStorePath()
  if not path then return end
  local ok, text = pcall(noctalia.json.encode, externalExtra)
  if ok and text then pcall(noctalia.writeFile, path, text) end
end

loadExternalExtra()

local function appendExternalGames()
  local function merge(list)
    for _, g in ipairs(list) do
      local duplicate = false
      for _, e in ipairs(games) do
        if e.id == g.id or e.name == g.name then
          duplicate = true
          break
        end
      end
      if not duplicate then
        table.insert(games, g)
      end
    end
  end
  merge(EXTERNAL_GAMES)
  merge(externalExtra)
  table.sort(games, function(a, b)
    return tostring(a.name or ""):lower() < tostring(b.name or ""):lower()
  end)
end

-- Nombre legible a partir del .exe: la carpeta del juego suele describirlo
-- mejor que el binario ("u4.exe" dentro de "Uncharted 4 Legacy of Thieves
-- Collection"). Carpetas genéricas se ignoran y se usa el nombre del .exe.
local GENERIC_FOLDERS = {
  bin = true, binaries = true, win64 = true, win32 = true, x64 = true,
  x86 = true, game = true, games = true, build = true, release = true,
  windows = true, system32 = true, syswow64 = true, system = true,
  ["program files"] = true, ["program files (x86)"] = true,
  ["common files"] = true, steamapps = true, common = true,
}

local function nameFromExe(exePath)
  local file = exePath:match("([^/]+)$") or "Juego"
  local base = file:gsub("%.[eE][xX][eE]$", ""):gsub("[_]+", " ")
  local parent = exePath:match("^(.*)/[^/]+$") or ""
  local folder = parent:match("([^/]+)$")
  -- La carpeta solo manda si describe más que el binario ("u4.exe" dentro de
  -- "Uncharted 4 Legacy of Thieves Collection") y no es una carpeta genérica.
  if folder and #folder > #base and not GENERIC_FOLDERS[folder:lower()] then
    return (folder:gsub("[_]+", " "))
  end
  return base
end

-- Nombre sugerido para la caja de texto del paso de nombre.
nameForAdd = function(exePath)
  return nameFromExe(exePath)
end

local function slugifyName(text)
  local slug = tostring(text or ""):lower()
  slug = slug:gsub("[^%w%-]+", "-"):gsub("^[%-]+", ""):gsub("[%-$]+", "")
  if slug == "" then slug = "juego" end
  return slug
end

local function uniqueGameId(base)
  local id, n = base, 2
  while true do
    local taken = false
    for _, g in ipairs(games) do
      if g.id == id then taken = true break end
    end
    if not taken then
      for _, g in ipairs(externalExtra) do
        if g.id == id then taken = true break end
      end
    end
    if not taken then return id end
    id = base .. "-" .. n
    n = n + 1
  end
end

-- Portada opcional: busca el título en la tienda de Steam y baja su retrato
-- 600x900 (o la cabecera 460x215 si el juego no tiene retrato). Después deja
-- preparada la animación del disco, para que la caja la tenga la primera vez.

-- Palabras que no sirven para distinguir un juego de otro, o que solo dicen
-- de qué edición se trata.
local COVER_STOPWORDS = {
  ["of"] = true, ["the"] = true, ["a"] = true, ["an"] = true,
  ["and"] = true, ["collection"] = true, ["edition"] = true,
  ["definitive"] = true, ["remastered"] = true, ["deluxe"] = true,
  ["complete"] = true, ["goty"] = true, ["game"] = true, ["year"] = true,
}

-- "UNCHARTED™: Legacy of Thieves Collection" -> {"uncharted", "legacy", "thieves"}
local function coverWords(s)
  s = tostring(s or ""):lower():gsub("™", ""):gsub("®", ""):gsub("©", "")
  s = s:gsub("[^%w%s]", " "):gsub("%s+", " ")
  local out = {}
  for w in s:gmatch("%S+") do
    if not COVER_STOPWORDS[w] then out[#out + 1] = w end
  end
  return out
end

-- Parecido entre dos títulos: palabras en común / palabras del más largo.
-- Así "Uncharted 4 Legacy of Thieves Collection" casa con "Uncharted: Legacy
-- of Thieves Collection" (0,75) aunque no sean idénticos ni se contengan.
local function coverScore(a, b)
  local A, B = coverWords(a), coverWords(b)
  if #A == 0 or #B == 0 then return 0 end
  local set = {}
  for _, w in ipairs(A) do set[w] = true end
  local hits = 0
  for _, w in ipairs(B) do if set[w] then hits = hits + 1 end end
  return hits / math.max(#A, #B)
end

local function applyCover(g, dest)
  pcall(function()
    g.cover = dest
    coverExists[dest] = true
    -- El JSON se guardó antes de bajar la portada: se vuelve a escribir para
    -- que la caja la conserve al reiniciar.
    saveExternalExtra()
    render()
    -- Portada nueva => el disco se rehace con ella.
    if prepareDisc then prepareDisc(g, true) end
  end)
end

-- Los juegos nuevos de Steam ya no sirven la portada en la ruta fija
-- .../steam/apps/<id>/library_600x900.jpg: la guardan en una carpeta con hash
-- y solo la tienda conoce la URL. Cuando falla la ruta clásica se pide esa
-- cabecera a la API y se compone un retrato 600x900 con ella.
local function buildPortrait(src, dest)
  local cmd = "magick \\( " .. shellQuote(src) .. " -resize \"600x900^\" -gravity center"
    .. " -extent 600x900 -blur 0x28 -modulate 62 \\) \\( " .. shellQuote(src)
    .. " -resize \"600x310\" \\) -gravity center -composite " .. shellQuote(dest)
    .. " && rm -f " .. shellQuote(src)
  return cmd
end

local function downloadCoverFor(g, appid)
  local dest = steamCoverDir .. "/" .. g.id .. "_p.jpg"
  local id = tostring(appid)
  local cdn = "https://cdn.cloudflare.steamstatic.com/steam/apps/" .. id

  -- 2) Juego nuevo: la API de la tienda da la URL real de la cabecera.
  local function viaStoreApi()
    local ok = pcall(function()
      noctalia.http({
        url = "https://store.steampowered.com/api/appdetails?appids=" .. id .. "&l=english",
      }, function(res)
        pcall(function()
          if not (res and res.ok and res.status == 200) then return end
          local decoded, data = pcall(noctalia.json.decode, res.body or "")
          if not decoded or type(data) ~= "table" then return end
          local entry = data[id]
          local header = entry and entry.data and entry.data.header_image
          if type(header) ~= "string" then return end
          local tmp = dest .. ".hdr.jpg"
          noctalia.download(header, tmp, function(ok2)
            pcall(function()
              if not (ok2 and noctalia.fileExists(tmp)) then return end
              noctalia.runAsync(buildPortrait(tmp, dest), function(r2)
                pcall(function()
                  if r2 and r2.exitCode == 0 and noctalia.fileExists(dest) then
                    applyCover(g, dest)
                  else
                    -- Sin ImageMagick o sin cabecera: se deja la imagen tal cual.
                    if noctalia.fileExists(tmp) then
                      pcall(noctalia.copyFile, tmp, dest)
                    end
                    if noctalia.fileExists(dest) then applyCover(g, dest) end
                  end
                end)
              end)
            end)
          end)
        end)
      end)
    end)
    if not ok then noctalia.log("downloadCoverFor: fallo pidiendo la API de la tienda") end
  end

  noctalia.download(cdn .. "/library_600x900.jpg", dest, function(ok2)
    pcall(function()
      if ok2 and noctalia.fileExists(dest) then
        applyCover(g, dest)
        return
      end
      -- 1) Juegos anteriores a 2022: la cabecera sí está en la ruta clásica.
      noctalia.download(cdn .. "/header.jpg", dest, function(ok3)
        pcall(function()
          if ok3 and noctalia.fileExists(dest) then
            applyCover(g, dest)
          else
            viaStoreApi()
          end
        end)
      end)
    end)
  end)
end

local function fetchCoverByName(g)
  local dest = steamCoverDir .. "/" .. g.id .. "_p.jpg"
  if noctalia.fileExists(dest) then
    g.cover = dest
    if prepareDisc then prepareDisc(g) end
    return
  end

  local words = coverWords(g.name)
  if #words == 0 then return end

  -- La tienda no entiende títulos largos: "Uncharted 4 Legacy of Thieves
  -- Collection" devuelve 0 resultados y "Uncharted" sí lo encuentra. Se
  -- prueban el nombre entero y variantes cada vez más cortas hasta que
  -- alguna coincidencia pase de 0,6 de parecido.
  local best, bestScore = nil, 0

  local function search(n)
    if n < 1 then
      if best then downloadCoverFor(g, best.id) end
      return
    end
    local picked = {}
    for i = 1, n do picked[i] = words[i] end
    local term = table.concat(picked, "+")
    local url = "https://store.steampowered.com/api/storesearch/?term="
      .. term .. "&l=english&cc=US&count=10"
    local ok = pcall(function()
      noctalia.http({ url = url }, function(res)
        pcall(function()
          if res and res.ok and res.status == 200 then
            local decoded, data = pcall(noctalia.json.decode, res.body or "")
            if decoded and type(data) == "table" and type(data.items) == "table" then
              for _, item in ipairs(data.items) do
                if item.id then
                  local sc = coverScore(g.name, item.name)
                  if sc > bestScore then best, bestScore = item, sc end
                end
              end
            end
          end
          if bestScore >= 0.6 and best then
            downloadCoverFor(g, best.id)
          elseif n > 1 then
            search(n - 1)
          elseif best then
            downloadCoverFor(g, best.id)   -- último recurso: la mejor que haya
          end
        end)
      end)
    end)
    if not ok then noctalia.log("fetchCoverByName: no se pudo consultar la tienda") end
  end
  search(#words)
end

addGameFromExe = function(exePath, gameName)
  if not exePath or #exePath == 0 then return nil end
  -- Mismo .exe ya conocido (en memoria o en el JSON): se reutiliza.
  for _, g in ipairs(games) do
    if g.runner == "external" and g.exe == exePath then return g end
  end
  for _, g in ipairs(externalExtra) do
    if g.exe == exePath then return g end
  end
  -- El nombre lo escribe el usuario en el paso anterior; si viene vacío se
  -- deduce del .exe. Es el que se usa para buscar la portada en Steam.
  local name = tostring(gameName or ""):gsub("^%s+", ""):gsub("%s+$", "")
  name = name:gsub("%s+", " ")
  if name == "" then name = nameFromExe(exePath) end
  -- Ya hay un juego con ese título (dos .exe en la misma carpeta): se
  -- distingue con el nombre del binario para no tener dos filas iguales.
  local nameLower = name:lower()
  local function sameName(other)
    return tostring(other.name or ""):lower() == nameLower
  end
  local taken = false
  for _, other in ipairs(games) do
    if sameName(other) then taken = true break end
  end
  if not taken then
    for _, other in ipairs(externalExtra) do
      if sameName(other) then taken = true break end
    end
  end
  if taken then
    local base = (exePath:match("([^/]+)$") or ""):gsub("%.[eE][xX][eE]$", "")
    name = name .. " (" .. base .. ")"
  end
  local g = {
    id = uniqueGameId(slugifyName(name)),
    name = name,
    runner = "external",
    cover = "",
    cover_url = "",
    exe = exePath,
    -- Marcado como añadido con el botón: solo estos buscan portada y disco
    -- automáticamente.
    autoCover = true,
  }
  table.insert(games, g)
  table.insert(externalExtra, g)
  saveExternalExtra()
  fetchCoverByName(g)
  return g
end

local function appendDesktopAndExternalGames()
  pcall(appendDesktopGames)
  pcall(appendExternalGames)
end

---------------------------------------------------------------------------
--- Plegado de variantes: "Stellar Blade (gamescope)" deja de ocupar su
--- propia fila en cuanto su título base está en la lista, para que el juego
--- se enseñe una sola vez. Sus otras formas de abrirse aparecen al pulsar la
--- fila. Si el base no llega a pasar los filtros, la variante queda a solas
--- y sigue siendo localizable por su nombre.
---------------------------------------------------------------------------

local function isVariant(name)
  return tostring(name or ""):find("%b()") ~= nil
end

local function baseTitle(name)
  return (tostring(name or ""):gsub("%s*%b()$", "")):lower()
end

local function foldVariants(list)
  local bases = {}
  for _, g in ipairs(list) do
    if not isVariant(g.name) then bases[baseTitle(g.name)] = true end
  end
  local out = {}
  for _, g in ipairs(list) do
    if not (isVariant(g.name) and bases[baseTitle(g.name)]) then
      table.insert(out, g)
    end
  end
  return out
end

-- Índice por título base. expandableVariants() se llama una vez por fila en
-- cada render; recalcularlo recorriendo todo `games` era O(n²) y podía agotar
-- el presupuesto de CPU del callback.
local variantsByBase = {}

local function rebuildVariantIndex()
  local idx = {}
  for _, g in ipairs(games) do
    local base = baseTitle(g.name)
    local list = idx[base]
    if not list then list = {}; idx[base] = list end
    table.insert(list, g)
  end
  variantsByBase = idx
end

local function filterGames(text)
  rebuildVariantIndex()
  local pool = {}
  for _, g in ipairs(games) do
    -- Temporales: "League of Maidens" y el placeholder "appid_350470" fueron
    -- retirados del launcher a petición del usuario y no entran en la vitrina.
    local nameLower = tostring(g.name or ""):lower()
    if nameLower ~= "league of maidens" and nameLower ~= "appid_350470" then
      if filterByRunner(g) then
        table.insert(pool, g)
      end
    end
  end
  if text == "" then
    filtered = foldVariants(pool)
    return
  end
  local lower = text:lower()
  local result = {}
  for _, g in ipairs(pool) do
    if g.name:lower():find(lower, 1, true) or g.runner:lower():find(lower, 1, true) then
      table.insert(result, g)
    end
  end
  filtered = foldVariants(result)
end

local function isImageFile(path)
  return noctalia.fileExists(path)
end

local function fetchSteamStoreCover(g, dest, cb)
  noctalia.http({ url = "https://store.steampowered.com/api/appdetails?appids=" .. g.id }, function(res2)
    pcall(function()
      if res2.ok and res2.status == 200 then
        local ok2, data2 = pcall(noctalia.json.decode, res2.body)
        if ok2 and data2 then
          local appData = data2[g.id]
          if appData and appData.data and appData.data.header_image then
            noctalia.download(appData.data.header_image, dest, function(ok3)
              pcall(function() if ok3 then g.cover = dest; render() end end)
            end)
            return
        end
      end
      end
    end)
  end)
end

local function fetchSteampoacherCover(g, dest, fallback)
  noctalia.http({ url = "https://steam-asset-proxy.steampoacher.workers.dev?appid=" .. g.id }, function(res)
    pcall(function()
      if res.ok and res.status == 200 then
        local ok, data = pcall(noctalia.json.decode, res.body)
        if ok and data and data.response and data.response.store_items then
          local item = data.response.store_items[1]
          if item and item.assets then
            local assets = item.assets
            local filename = assets.library_capsule_2x or assets.library_capsule or assets.header
            local fmt = assets.asset_url_format
            if filename and fmt then
              local placeholder = "${FILENAME}"
              local pos = fmt:find(placeholder, 1, true)
              local cdnUrl
              if pos then
                local prefix = fmt:sub(1, pos - 1)
                local suffix = fmt:sub(pos + #placeholder)
                cdnUrl = "https://shared.steamstatic.com/store_item_assets/" .. prefix .. filename .. suffix
              else
                cdnUrl = "https://shared.steamstatic.com/store_item_assets/" .. fmt .. "/" .. filename
              end
              noctalia.download(cdnUrl, dest, function(ok2)
                pcall(function()
                  if ok2 then g.cover = dest; render() return end
                  fallback()
                end)
              end)
              return
            end
          end
        end
      end
      pcall(function() fallback() end)
    end)
  end)
end

-- Retrato de caja (600x900) del CDN de Steam: es la carátula que usa la
-- estantería. Si la app no lo tiene (juegos retirados, apps que no son
-- juegos...), se cae al header apaisado de la API de la tienda.
local function fetchSteamPortraitCover(g, dest, fallback)
  local url = "https://cdn.cloudflare.steamstatic.com/steam/apps/" .. g.id .. "/library_600x900.jpg"
  noctalia.download(url, dest, function(ok)
    pcall(function()
      if ok then
        g.cover = dest
        render()
      else
        fallback()
      end
    end)
  end)
end

local function downloadSteamCover(g)
  local ok, err = pcall(function()
    -- _p: retrato. Nombre distinto del .jpg apaisado que cachea el escáner,
    -- así las carátulas viejas no impiden pedir la caja vertical.
    local dest = steamCoverDir .. "/" .. g.id .. "_p.jpg"
    if isImageFile(dest) then
      g.cover = dest
      return
    end
    local steampoacherEnabled = false
    local okc, val = pcall(noctalia.getConfig, "steampoacher_enabled")
    if okc then
      steampoacherEnabled = val == true or val == "true"
    end
    local function headerCover()
      fetchSteamStoreCover(g, dest)
    end
    local function portraitCover()
      fetchSteamPortraitCover(g, dest, headerCover)
    end
    if steampoacherEnabled then
      fetchSteampoacherCover(g, dest, portraitCover)
    else
      portraitCover()
    end
  end)
  if not ok then
    noctalia.log("downloadSteamCover error: " .. tostring(err))
  end
end

local function downloadHeroicCover(g)
  local ok, err = pcall(function()
    if g.cover and #g.cover > 0 then return end
    if not g.cover_url or #g.cover_url == 0 then return end
    local dest = heroicCoverDir .. "/" .. g.id .. ".jpg"
    if isImageFile(dest) then
      g.cover = dest
      return
    end
    noctalia.download(g.cover_url, dest, function(ok2)
      pcall(function()
        if ok2 then g.cover = dest; render() end
      end)
    end)
  end)
  if not ok then
    noctalia.log("downloadHeroicCover error: " .. tostring(err))
  end
end

local function fetchMissingCovers()
  for _, g in ipairs(games) do
    if g.runner == "steam" then
      downloadSteamCover(g)
    elseif g.runner == "heroic" then
      downloadHeroicCover(g)
    elseif g.runner == "external" then
      -- Solo los juegos añadidos con el botón "Añadir juego" (autoCover)
      -- buscan portada en Steam. Los fijados a mano o los que ya estaban no
      -- se tocan: cada uno se queda con la imagen que tenga.
      local has = g.cover and #g.cover > 0 and noctalia.fileExists(g.cover)
      if not has and g.autoCover then
        fetchCoverByName(g)
      elseif has and prepareDisc then
        prepareDisc(g)
      end
    end
  end
end

