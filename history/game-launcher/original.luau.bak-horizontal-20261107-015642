      end,
    }))
  end

  return ui.column({ align = "center", gap = 6 }, {
    ui.label({
      text = g.name,
      fontSize = 20,
      fontWeight = "bold",
      color = "on_surface",
      maxLines = 1,
    }),
    ui.row({ align = "center", gap = 6 }, info),
    ui.row({ align = "center", gap = 8 }, buttons),
    (expandedId == g.id and renderLaunchOptions()) or ui.row(),
